# Copy to .env.local for `vercel dev`. Never commit real values.
ANTHROPIC_API_KEY=
# Model for the image-reading agents (default claude-sonnet-5-5)
A100_MODEL=
# Daily limits per IP
A100_PAGES_PER_DAY=60
A100_INVITES_PER_DAY=30
A100_GLOBAL_DAILY_LIMIT=
A100_IP_SALT=
# Rate limiting store (Upstash Redis REST). Either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
